# Environment variables for Ahjoor.
#
# Copy this file to `.env.local` and adjust the values. Every variable is
# optional: with an empty file the app runs entirely on the bundled mock
# data, which is the default for local development.
#
# The values are validated at startup by `lib/env.ts` (schema-checked with
# zod). If a value is malformed — or if a variable that the chosen
# configuration needs is missing — the app fails immediately with a message
# that names every problem, rather than misbehaving later.

# ---------------------------------------------------------------------------
# API backend
# ---------------------------------------------------------------------------

# Base URL of the backend API. When set, the typed API client (lib/api)
# uses the HTTP adapter and sends requests to ${NEXT_PUBLIC_API_URL}/circles,
# /contributions, /payouts, /notifications, etc.
# When unset, the app falls back to the bundled mock adapter (lib/api/mock.ts),
# which serves the same shapes from data/*.ts with simulated latency — this
# is the default for local development, so the app works out of the box.
# Must be an absolute http(s) URL.
NEXT_PUBLIC_API_URL=

# Which API implementation serves the data: "mock" or "http".
# Leave unset to let the app decide: "http" when NEXT_PUBLIC_API_URL is set,
# "mock" otherwise. Set it explicitly only to override that.
# Setting it to "http" requires NEXT_PUBLIC_API_URL to be set as well.
NEXT_PUBLIC_API_ADAPTER=

# ---------------------------------------------------------------------------
# Stellar network
# ---------------------------------------------------------------------------

# The network the app operates on: "testnet", "mainnet", "standalone" or
# "futurenet". Defaults to "testnet".
NEXT_PUBLIC_STELLAR_NETWORK=

# Network passphrase the app compares a connected wallet's network against
# (see components/wallet/NetworkGuard.tsx).
# Defaults to the passphrase of the network selected above.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# Human-readable network name shown in the network-mismatch guard.
# Defaults to the label of the network selected above ("Testnet", "Mainnet",
# "Standalone" or "Futurenet").
NEXT_PUBLIC_STELLAR_NETWORK_LABEL=

# ---------------------------------------------------------------------------
# Connectivity
# ---------------------------------------------------------------------------

# Optional: endpoint periodically pinged to detect connectivity/reconnects.
# Defaults to "/" when unset.
NEXT_PUBLIC_HEARTBEAT_URL=

# Optional: Starknet RPC endpoint used to estimate on-chain gas fees.
# Gas fee estimation falls back to a static estimate when unset.
# Must be an absolute http(s) URL.
NEXT_PUBLIC_STARKNET_RPC_URL=

# ---------------------------------------------------------------------------
# Payouts
# ---------------------------------------------------------------------------

# Optional: toggles the bank-transfer off-ramp payout option.
# Defaults to enabled; set to "false" to hide it.
NEXT_PUBLIC_OFFRAMP_ENABLED=true

# Optional: display name for the off-ramp partner shown in payout method UI.
NEXT_PUBLIC_OFFRAMP_PARTNER=Bank transfer partner
